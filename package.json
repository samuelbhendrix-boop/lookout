{
  "name": "lookout",
  "version": "0.13.1",
  "private": true,
  "description": "Competitive intelligence signal tracker: ingest competitor sources, classify signals, triage, alert.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && npm run build:import",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "smoke": "tsx scripts/smoke.ts",
    "market:import": "tsx scripts/import-market-data.ts",
    "mrf:reduce": "tsx scripts/mrf-reduce.ts",
    "medicare:build": "tsx scripts/build-medicare-reference.ts",
    "mrf:snapshot": "tsx scripts/build-rate-snapshot.ts",
    "mrf:refresh": "tsx scripts/refresh-snapshots.ts",
    "build:import": "esbuild scripts/import-market-data.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/import-market-data.cjs --log-level=warning"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "2.4.3",
    "csv-parse": "5.6.0",
    "d3-geo": "^3.1.1",
    "exceljs": "4.4.0",
    "jose": "^5.9.6",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rss-parser": "3.13.0",
    "stream-json": "^1.9.1",
    "topojson-client": "^3.1.0",
    "tsx": "4.20.5",
    "us-atlas": "^3.0.1",
    "yauzl": "3.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/stream-json": "^1.7.8",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/yauzl": "2.10.3",
    "autoprefixer": "10.4.21",
    "esbuild": "^0.25.12",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
