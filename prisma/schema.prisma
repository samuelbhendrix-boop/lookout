// Lookout — competitive intelligence signal tracker
// Multi-tenant: every business row carries workspaceId. All queries are scoped through it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & tenancy ──────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  icon         String? // small image as a data: URL, or an emoji
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  comments     Comment[]
  invites      Invite[]
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  icon        String? // small image as a data: URL, or an emoji
  slug        String       @unique
  // The workspace's own carrier (one of its competitors rows), so every view can compare against "us".
  ownCompetitorId String?
  createdAt   DateTime     @default(now())
  memberships Membership[]
  competitors Competitor[]
  sources     Source[]
  signals     Signal[]
  tags        Tag[]
  alertRules  AlertRule[]
  jobs        Job[]
  invites     Invite[]
}

enum Role {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(ANALYST)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Session {
  id          String   @id @default(cuid())
  tokenHash   String   @unique // sha256 of the cookie token; raw token never stored
  userId      String
  workspaceId String // active workspace for this session
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Domain ──────────────────────────────────────────────────────────

model Competitor {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  website       String?
  // Lowercase aliases used by the matcher to attribute untagged signals ("uhc", "unitedhealthcare")
  aliases       String[]
  tier          Int       @default(2) // 1 = primary threat, 3 = watch list
  notes         String?
  // Regex (case-insensitive) matched against legal company names in public filings, e.g.
  // "harvard pilgrim|hphc|tufts (associated|insurance)". Null → curated default or aliases.
  issuerPattern String?
  // "region": keep only news that touches New England (or the carrier's commercial/exchange strategy); for national
  // carriers whose national news would otherwise flood the feed. "all": keep everything that names the carrier.
  newsScope     String    @default("all")
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sources       Source[]
  signals       Signal[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

enum SourceKind {
  RSS
  MANUAL
  WEBPAGE
}

model Source {
  id           String      @id @default(cuid())
  workspaceId  String
  competitorId String? // null = general market source; matcher attributes per item
  name         String
  kind         SourceKind  @default(RSS)
  url          String?
  enabled      Boolean     @default(true)
  pollMinutes  Int         @default(60)
  lastPolledAt DateTime?
  lastError    String?
  state        Json? // WEBPAGE: links already seen / page text fingerprint
  createdAt    DateTime    @default(now())
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  signals      Signal[]

  @@index([workspaceId])
  @@index([enabled, lastPolledAt])
}

enum SignalType {
  PRICING
  PRODUCT
  NETWORK
  REGULATORY
  LEADERSHIP
  M_AND_A
  PARTNERSHIP
  FINANCIAL
  OTHER
}

enum SignalStatus {
  NEW
  REVIEWED
  ESCALATED
  ARCHIVED
}

model Signal {
  id            String       @id @default(cuid())
  workspaceId   String
  sourceId      String?
  competitorId  String?
  title         String
  url           String?
  summary       String?
  // sha256(workspaceId + normalized url|title) — dedupes across sources and re-polls
  dedupeKey     String
  type          SignalType   @default(OTHER)
  importance    Int          @default(2) // 1–5
  status        SignalStatus @default(NEW)
  publishedAt   DateTime?
  // Story clustering: other outlets' coverage of the same event points at the lead signal.
  // The feed shows leads only; alerts fire on leads only.
  duplicateOfId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  duplicateOf   Signal?      @relation("Coverage", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  coverage      Signal[]     @relation("Coverage")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source        Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  competitor    Competitor?  @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  tags          SignalTag[]
  comments      Comment[]

  @@unique([workspaceId, dedupeKey])
  // Feed query: workspace + filters, newest first
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, competitorId, createdAt(sort: Desc)])
  @@index([workspaceId, type, createdAt(sort: Desc)])
  @@index([duplicateOfId])
  @@index([workspaceId, publishedAt(sort: Desc)])
}

model Tag {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  signals     SignalTag[]

  @@unique([workspaceId, name])
}

model SignalTag {
  signalId String
  tagId    String
  signal   Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([signalId, tagId])
  @@index([tagId])
}

model Comment {
  id        String   @id @default(cuid())
  signalId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([signalId, createdAt])
}

// ─── Alerting ────────────────────────────────────────────────────────

enum AlertMode {
  INSTANT // one message per matching signal
  DIGEST_WEEKLY // one roll-up message per 7 days
}

model AlertRule {
  id            String       @id @default(cuid())
  workspaceId   String
  name          String
  enabled       Boolean      @default(true)
  mode          AlertMode    @default(INSTANT)
  // Match conditions — all set conditions must hold (AND). Empty = any.
  competitorIds String[]
  types         SignalType[]
  keywords      String[] // case-insensitive substring on title+summary, any-of
  minImportance Int          @default(1)
  // Delivery: Slack-compatible incoming webhook ({ text })
  webhookUrl    String
  lastFiredAt   DateTime?
  createdAt     DateTime     @default(now())
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@index([mode, enabled, lastFiredAt])
}

// ─── Background jobs (Postgres queue, FOR UPDATE SKIP LOCKED) ────────
// Swap for BullMQ/SQS when throughput demands it; the job contract stays the same.

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Job {
  id          String     @id @default(cuid())
  workspaceId String? // null for global jobs (public market data imports)
  kind        String // "poll_source" | "deliver_alert" | "send_digest" | "import_market_data"
  payload     Json
  status      JobStatus  @default(QUEUED)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  runAt       DateTime   @default(now())
  lastError   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

// ─── Invites ─────────────────────────────────────────────────────────
// Shareable join link; token is hashed like sessions. Multi-use until expiry/revoke so one
// link can go in a team channel; maxUses caps it.

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  tokenHash   String    @unique
  role        Role      @default(ANALYST)
  createdById String
  maxUses     Int       @default(25)
  uses        Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── Public market data (shared across workspaces; sourced from CMS public use files) ───
// Mapped to a workspace's competitors at query time via Competitor.issuerPattern.

/**
 * One ACA single-risk-pool rate filing (URRT Worksheet 1): individual or small group.
 */
model RateFiling {
  id               String     @id // URRT submission tracking number, e.g. URR-42690MA-2026-50
  planYear         Int
  serffNumber      String?
  primaryReviewer  String? // "State" | "CMS"
  state            String
  hiosId           String
  company          String
  market           String // "Individual" | "Small Group"
  effectiveDate    DateTime
  expPremium       Float?
  expClaims        Float?
  expMemberMonths  Float?
  projMemberMonths Float?
  projIndexRate    Float?
  plans            RatePlan[]

  @@index([state, planYear])
  @@index([company])
}

/**
 * One plan within a rate filing (URRT Worksheet 2). Quarterly refilings produce one row per filing.
 */
model RatePlan {
  id              String     @id @default(cuid())
  filingId        String
  planYear        Int
  state           String
  hiosId          String
  company         String
  market          String
  productId       String
  productName     String
  planId          String
  planName        String
  metal           String?
  planType        String?
  onExchange      Boolean
  category        String // "New" | "Renewing" | "Terminated"
  effectiveDate   DateTime
  rateChange      Float? // cumulative rate change for the plan, e.g. 0.1049
  enrollment      Int? // current enrollment at filing
  ratePmpm        Float? // current premium per member per month
  expLossRatio    Float?
  projPremiumPmpm Float?
  determination   String?
  filing          RateFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)

  @@unique([filingId, planId])
  @@index([state, planYear, market])
  @@index([company])
  @@index([planId])
}

enum Segment {
  INDIVIDUAL
  SMALL_GROUP
  LARGE_GROUP
}

/**
 * Annual comprehensive-major-medical financials by legal entity × state × segment (CMS MLR reports).
 */
model MarketFinancial {
  id           String  @id @default(cuid())
  year         Int
  state        String
  hiosId       String?
  company      String
  naicCode     String?
  groupName    String?
  segment      Segment
  premium      Float
  claims       Float
  coveredLives Float
  memberMonths Float
  brokerFees   Float

  @@unique([year, state, company, segment])
  @@index([state, year, segment])
  @@index([company])
}

/**
 * Import bookkeeping for each public dataset/year.
 */
model DataImport {
  id         String    @id @default(cuid())
  dataset    String // "urrt" | "mlr"
  year       Int
  url        String
  status     String // "running" | "done" | "failed"
  rows       Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([dataset, year])
}

// ─── State large-group data (incl. self-insured) ─────────────────────

enum Funding {
  FULLY_INSURED
  SELF_INSURED
}

/**
 * Membership by carrier × funding × market sector, from state sources (MA CHIA, NH NHID).
 */
model MarketEnrollment {
  id          String   @id @default(cuid())
  source      String // "ma_chia" | "nh_nhid"
  state       String
  asOf        DateTime
  payer       String // canonical name (matched by Competitor.issuerPattern)
  funding     Funding
  segment     Segment
  sector      String // source's own label, e.g. "Jumbo-Size Group (501+)"
  productType String   @default("")
  members     Float
  estimated   Boolean  @default(false) // true when derived from published shares
  note        String?

  @@unique([source, state, asOf, payer, funding, sector, productType])
  @@index([state, segment, asOf])
  @@index([payer])
}

/**
 * Self-funded (ASO) lives a carrier administers, by the state the contract is written in. From the "uninsured plans"
 * column of CMS's loss-ratio filings (the same figures as the NAIC Supplemental Health Care Exhibit), plus estimates
 * for carriers that don't report by state (lib/marketdata/aso-estimate.ts).
 */
model SelfFundedLives {
  id           String  @id @default(cuid())
  year         Int
  state        String
  company      String // legal entity as filed (matched to competitors by issuer pattern)
  groupName    String?
  lives        Float
  memberMonths Float?
  fees         Float? // income from fees of uninsured plans
  basis        String // "reported" | "allocated" (home-state roll-up spread by fully insured presence) | "disclosed" (national total from the carrier's 10-K, spread the same way)
  note         String?

  @@unique([year, state, company, basis])
  @@index([state, year])
}

/**
 * Carrier financials published by a state regulator (e.g. Maine BOI) — adds admin & underwriting gain.
 */
model StateFinancial {
  id               String  @id @default(cuid())
  source           String // "me_boi"
  state            String
  year             Int
  company          String
  segment          Segment
  coveredLives     Float?
  memberMonths     Float?
  premium          Float
  claims           Float
  reserveChange    Float?
  adminExpense     Float?
  underwritingGain Float?
  isTotal          Boolean @default(false)

  @@unique([source, state, year, company, segment])
  @@index([state, segment, year])
}

/**
 * Rate actions reviewed by a state regulator (e.g. RI OHIC large group), requested vs approved.
 */
model GroupRateAction {
  id        String  @id @default(cuid())
  source    String // "ri_ohic"
  state     String
  segment   Segment
  planYear  Int
  carrier   String // canonical name
  label     String // as printed by the regulator
  members   Float?
  requested Float?
  approved  Float?
  details   Json? // trend & retention components as printed
  isTotal   Boolean @default(false)

  @@unique([source, state, segment, planYear, carrier])
  @@index([state, segment, planYear])
}

// ─── Employer plans (DOL Form 5500 + Schedule A) ─────────────────────
// Public filings by employer health plans (100+ participants file the full Form 5500). Gives the
// employer → carrier → broker map, with persons covered, premium, claims, commissions, renewal month.

model EmployerPlan {
  id            String             @id @default(cuid())
  ackId         String             @unique // DOL filing id
  formYear      Int
  ein           String
  planNum       String
  sponsor       String
  dba           String?
  city          String?
  state         String
  zip           String?
  naics         String?
  planName      String
  planYearBegin DateTime
  participants  Int?
  /// "insured" (health insurance contract filed) | "self-funded" (benefits paid from employer assets/trust, no health contract) | "mixed"
  funding       String
  receivedAt    DateTime?
  contracts     EmployerContract[]
  providers     EmployerProvider[]

  @@index([state, planYearBegin])
  @@index([ein, planNum])
  @@index([sponsor])
}

model EmployerContract {
  id             String       @id @default(cuid())
  planId         String
  kind           String // "health" | "stop_loss"
  carrier        String
  carrierNaic    String?
  contractNum    String?
  personsCovered Int?
  premium        Float?
  claims         Float?
  brokerComm     Float?
  brokerFees     Float?
  policyFrom     DateTime?
  policyTo       DateTime?
  hmo            Boolean      @default(false)
  ppo            Boolean      @default(false)
  brokers        Json? // [{ name, city, state, commission, fees }]
  plan           EmployerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([carrier])
  @@index([planId])
}

// ─── Transparency in Coverage machine-readable files ─────────────────
// Every insurer/TPA must publish monthly table-of-contents files listing each plan it covers or
// administers — including self-funded employer plans, by employer EIN. Matched to Form 5500 EINs,
// this names the administrator of self-funded plans that their 5500 doesn't disclose.

model PlanAdministration {
  id              String    @id @default(cuid())
  carrier         String // canonical carrier name (matched by issuer patterns)
  reportingEntity String
  entityType      String? // "Health Insurance Issuer" | "Third-Party Administrator" …
  ein             String
  sponsorName     String?
  planName        String
  marketType      String?
  tocUrl          String?
  asOf            DateTime?
  fetchedAt       DateTime  @default(now())

  @@unique([carrier, ein, planName])
  @@index([ein])
}

/**
 * Registry + latest examination results for each carrier's machine-readable files.
 */
model MrfSource {
  id        String    @id // registry key, e.g. "cigna"
  carrier   String
  status    String // "ok" | "failed" | "manual"
  lastRunAt DateTime?
  error     String?
  stats     Json?
}

/// One payer rate file reduced by lib/marketdata/mrf (the multi-GB original is never stored).
model RateFile {
  id              String         @id // "<carrier>:<network>"
  carrier         String // registry id, e.g. "mgb"
  carrierName     String
  network         String
  url             String
  status          String // "ok" | "failed"
  error           String?
  reportingEntity String?
  lastUpdated     String?
  stats           Json?
  processedAt     DateTime?
  summaries       RateSummary[]
  providerRates   ProviderRate[]
}

/// Network-wide distribution of a code's negotiated rate (each provider TIN counted once).
model RateSummary {
  id             String   @id @default(cuid())
  fileId         String
  file           RateFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  code           String
  codeType       String
  billingClass   String
  negotiatedType String
  providers      Int
  p10            Float
  p25            Float
  p50            Float
  p75            Float
  p90            Float

  @@index([codeType, code])
}

/// Negotiated rate at a key provider (hospital, large group): the cross-carrier comparison grain.
model ProviderRate {
  id             String   @id @default(cuid())
  fileId         String
  file           RateFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  code           String
  codeType       String
  billingClass   String
  negotiatedType String
  tin            String
  providerName   String?
  npiCount       Int
  n              Int
  min            Float
  median         Float
  max            Float

  @@index([codeType, code, billingClass])
  @@index([tin])
}

/// A detected change in market data (account won/lost, rate filing, negotiated-rate change, network change).
/// Global; lib/marketdata/events.ts fans each one out as a Signal to workspaces tracking that carrier.
model MarketEvent {
  id         String   @id @default(cuid())
  eventKey   String   @unique // deterministic, so re-detection is idempotent
  kind       String // account_won | account_lost | rate_filing | rate_change | network_add | network_drop
  carrier    String // carrier name as it appears in the source (matched to competitors by issuer pattern)
  title      String
  summary    String
  url        String? // in-app path to the evidence
  importance Int      @default(2)
  state      String?
  data       Json?
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([kind, occurredAt(sort: Desc)])
  @@index([carrier])
}

/// Carrier-level negotiated rate per provider × service, one row per month — the basis for rate- and network-change events.
model RateHistory {
  carrier      String
  carrierName  String
  codeType     String
  code         String
  billingClass String
  tin          String
  month        String // YYYY-MM
  median       Float

  @@id([carrier, codeType, code, billingClass, tin, month])
  @@index([month])
}

// ─── Exchange plan designs (CMS QHP PUFs) ────────────────────────────
// Every individual and small-group plan certified for a state's Exchange: benefit design, cost sharing, network,
// service area and age-rated premiums. State-based Exchanges (MA, CT, RI, VT, ME) from CMS's SBE QHP PUF; federal
// platform states (NH) from the Exchange PUFs. Joined to RatePlan (rate filings) on planId for enrollment and rate change.

model QhpPlan {
  id            String   @id // `${year}:${planId}`
  year          Int
  state         String
  issuerId      String
  issuerName    String?
  market        String // "Individual" | "SHOP"
  planId        String // HIOS standard component id (14 chars), = RatePlan.planId
  productId     String // HIOS product id (10 chars)
  name          String
  metal         String?
  planType      String? // HMO | PPO | EPO | POS | Indemnity
  networkId     String?
  networkName   String?
  serviceAreaId String?
  statewide     Boolean  @default(false)
  counties      Int?
  isNew         Boolean  @default(false)
  standardized  Boolean  @default(false) // state/federal standardized design, not issuer-designed
  hsa           Boolean  @default(false)
  nationalNetwork Boolean @default(false)
  referral      Boolean  @default(false)
  tiered        Boolean  @default(false) // multiple in-network tiers
  outOfNetwork  Boolean  @default(false) // has an out-of-network benefit
  wellness      Boolean  @default(false)
  diseaseMgmt   String?
  av            Float? // issuer actuarial value, 0–1
  dedInd        Float? // in-network individual deductible (medical+drug if integrated, else medical)
  dedFam        Float?
  drugDed       Float? // separate drug deductible when not integrated
  moopInd       Float?
  moopFam       Float?
  coinsurance   Float? // in-network, after deductible, 0–1
  sbcBaby       Float? // SBC "having a baby": member's total cost (deductible + copays + coinsurance + excluded)
  sbcDiabetes   Float?
  sbcFracture   Float?
  costShare     Json? // FFE only: { pcp, specialist, er, urgent, generic, brand, specialty, inpatient } as filed text
  covered       String[] // benefit names covered (the full list; compare across plans)
  prem21        Float? // median monthly premium across rating areas, non-tobacco
  prem40        Float?
  prem60        Float?
  prem40Min     Float?
  prem40Max     Float?
  areaPrem40    Json? // { "Rating Area 1": 512.3, ... }
  sbcUrl        String?
  source        String // "SBE QHP PUF" | "Exchange PUF"

  @@index([state, year, market])
  @@index([issuerId])
  @@index([planId])
}

// Form 5500 Schedule C: service providers paid $5,000+ from plan assets — names the claims administrator (TPA/ASO) of
// self-funded plans and what it was paid, which Schedule A never shows.
model EmployerProvider {
  id         String       @id @default(cuid())
  planId     String
  name       String
  ein        String?
  relation   String? // as filed: "TPA", "CONTRACT ADMINISTRATOR", "BROKER", …
  codes      String[] // DOL service codes
  role       String // "administrator" | "broker" | "other"
  carrier    String? // canonical carrier name when the provider is one
  directComp Float?
  plan       EmployerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([carrier])
}

// ─── Hospital price transparency files (45 CFR 180) ──────────────────
// Each hospital's own machine-readable standard charges: the rate it has negotiated with every payer and plan.
// Fills carriers whose own rate files aren't reachable (BCBSMA's PPO networks, WellSense) and splits HMO vs PPO.
model HospitalRate {
  id          String  @id @default(cuid())
  fileId      String // HospitalFile.id
  tin         String? // EIN from the file name, when present
  hospital    String
  state       String?
  codeType    String // CPT | MS-DRG | APR-DRG (basket codes only)
  code        String
  setting     String? // inpatient | outpatient | both
  payer       String // as published
  plan        String?
  carrier     String? // canonical carrier, when recognised
  product     String? // HMO | PPO | POS | EPO | Self-insured | All
  dollar      Float?
  percentage  Float?
  methodology String?

  @@index([fileId])
  @@index([tin])
  @@index([carrier])
}

model HospitalFile {
  id          String   @id // mrf url hash
  domain      String
  hospital    String
  url         String
  state       String?
  tin         String?
  lastUpdated String?
  version     String?
  status      String // ok | failed | skipped
  error       String?
  rows        Int      @default(0)
  payers      Json? // [{ payer, plan, carrier, product, rows }]
  processedAt DateTime @default(now())
}

// ─── Plan provider directories and formularies (CMS machine-readable PUF) ───
// Exchange insurers publish, per plan, every provider in network and every covered drug (45 CFR 156.122/230).
model PlanNetworkStat {
  id          String @id // `${year}:${planId}`
  carrier     String
  issuerId    String
  planId      String
  year        Int
  individuals Int    @default(0)
  pcps        Int    @default(0)
  accepting   Int    @default(0)
  hospitals   Int    @default(0)
  facilities  Int    @default(0)
  byState     Json? // { NH: 1234, MA: 456 } individuals by practice state
  drugs       Int?
  pa          Int?
  st          Int?
  ql          Int?

  @@index([planId])
  @@index([carrier, year])
}

model PlanHospital {
  id      String @id @default(cuid())
  carrier String
  planId  String
  year    Int
  npi     String
  name    String
  city    String?
  state   String?

  @@index([planId, year])
}

model PlanDrug {
  id      String  @id @default(cuid())
  carrier String
  planId  String
  year    Int
  group   String // watch-list label, e.g. "GLP-1 for weight loss"
  covered Boolean
  tier    String?
  pa      Boolean @default(false)
  st      Boolean @default(false)
  ql      Boolean @default(false)
  drugs   Int     @default(0) // formulary entries in the group

  @@index([planId, year])
}

/// What each carrier pays New England providers for one service, by state and setting, from the monthly MRF extract
/// (GitHub release mrf-YYYY-MM, summary-code-rates.csv.gz). One median per provider group first, then the spread.
model MarketCodeRate {
  id           String @id @default(cuid())
  month        String
  carrier      String
  carrierName  String
  state        String
  codeType     String
  code         String
  billingClass String
  providers    Int
  p25          Float
  median       Float
  p75          Float

  @@index([codeType, code])
  @@index([state, billingClass])
}

/// A carrier's product-marketing page or brochure (lib/marketing): what the crawler last saw at that URL.
model ProductPage {
  id        String   @id @default(cuid())
  site      String   // lib/marketing/sites.ts key
  url       String   @unique
  title     String
  kind      String   // html | pdf
  text      String
  score     Int      @default(0)
  hash      String
  fetchedAt DateTime @default(now())
  changedAt DateTime @default(now())

  @@index([site])
}

/// A company's site icon (for competitor logos), fetched from its own website.
model SiteLogo {
  domain      String   @id
  contentType String
  data        Bytes
  source      String
  fetchedAt   DateTime @default(now())
}

/// First and last time a carrier's product or network was seen (large-group launch detection). kind: "marketed" (a
/// product on the carrier's own pages) or "network" (a network in its price-transparency index). Rows first seen in
/// the baseline pass are marked baseline, so only later arrivals count as launches.
model LaunchSighting {
  id        String   @id @default(cuid())
  kind      String
  site      String // marketing site key, or rate-file carrier id
  key       String // normalised name
  name      String
  detail    Json?
  baseline  Boolean  @default(false)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([kind, site, key])
  @@index([kind, firstSeen])
}

/// A state insurance filing from SERFF (uploaded by a user: SERFF Filing Access blocks automated download). Holds the
/// filing's header, plans, rate change, and an AI read of its description and any regulator objections.
model SerffFiling {
  id             String   @id @default(cuid())
  tracking       String   @unique
  state          String?
  company        String?
  toi            String?
  subToi         String?
  market         String? // Individual | Small Group | Large Group | Group
  filingType     String? // Form | Rate | Form/Rate | Plan Binder …
  productName    String?
  planYear       Int?
  submitted      DateTime?
  disposition    String?
  dispositionAt  DateTime?
  newProduct     Boolean  @default(false)
  rateChange     Float?
  summary        String?
  detail         Json?
  files          Json?
  uploadedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  access         SerffNetworkAccess[]
  crosswalk      SerffCrosswalk[]

  @@index([state, company])
}

/// Network adequacy (geo-access) rows from a filing: members, and the share within reach of each provider type, by county.
model SerffNetworkAccess {
  id        String      @id @default(cuid())
  filingId  String
  filing    SerffFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  network   String
  state     String?
  county    String
  specialty String
  members   Int?
  withAccess Int?
  pct       Float?

  @@index([filingId])
  @@index([network, county])
}

/// Plan crosswalk rows: where each plan's members go next year (renewed, mapped to another plan, discontinued).
model SerffCrosswalk {
  id        String      @id @default(cuid())
  filingId  String
  filing    SerffFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  fromPlan  String
  toPlan    String?
  reason    String?
  level     String?

  @@index([filingId])
}

/// AI-industry news that bears on health insurance (the "AI watch" page). Global, not per workspace: the same stories
/// matter to every payer. Collected from news searches every few hours; each story is judged once by a cheap model.
model AiNews {
  id          String    @id @default(cuid())
  url         String    @unique
  titleKey    String    @unique // normalised title: the same wire story from several outlets is kept once
  title       String
  outlet      String?
  summary     String?
  publishedAt DateTime?
  feed        String
  judged      Boolean   @default(false)
  relevant    Boolean   @default(false)
  category    String?
  impact      Int? // 3 = changes payer economics, operations or compliance; 2 = notable; 1 = background
  why         String? // why a payer should care, one line
  story       String? // short label for the underlying event, so several outlets' versions group together
  companies   String[]
  createdAt   DateTime  @default(now())

  @@index([relevant, publishedAt(sort: Desc)])
  @@index([judged])
}
