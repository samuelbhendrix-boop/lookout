DATABASE_URL="postgresql://lookout:lookout@localhost:5432/lookout?schema=public"
APP_URL="http://localhost:3000"
# Optional: enables LLM classification (falls back to keyword rules when unset)
ANTHROPIC_API_KEY=""
CLASSIFIER_MODEL="claude-haiku-5-5"
WORKER_TICK_MS=15000
WORKER_CONCURRENCY=5
# Dev/CI only — never in production:
# ALLOW_PRIVATE_URLS=true   (lets feeds/webhooks hit localhost)
# ALLOW_HTTP_WEBHOOKS=true  (accepts http:// webhook URLs)
